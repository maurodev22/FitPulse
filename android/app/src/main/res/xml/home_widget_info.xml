<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración del widget: banda horizontal de 4 celdas (agua de hoy, pasos,
     BPM y racha). El refresco automático mínimo es 30 min; además el servicio
     de pasos en primer plano lo repinta en vivo y la app lo refresca al
     instante cuando cambian datos reales (agua, BPM, racha). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/home_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />